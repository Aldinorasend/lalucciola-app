# Copy to .env for local development. Never commit .env.

# Matches docker-compose.yml (local dev only)
DATABASE_URL="postgresql://lalucciola:lalucciola_dev@localhost:5433/lalucciola?schema=public"

# Auth.js secret. Generate one with: npx auth secret
AUTH_SECRET=""

# First Owner account created by `npm run db:seed` (local dev values; change for production)
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@lalucciola.local"
SEED_OWNER_PASSWORD="owner-dev-password"

# Optional: also create manager@lalucciola.local and staff@lalucciola.local (local dev only)
SEED_DEMO_PASSWORD="demo-dev-password"
