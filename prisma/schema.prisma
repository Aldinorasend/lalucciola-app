// Data model: see wiki/architecture/data-model.md
// Phase 0 only adds users and roles; booking and inventory models arrive with their phases.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bookings     Booking[]
  closures     AreaClosure[]
}

// Booking settings: wiki/modules/settings.md, wiki/modules/floor-plan.md

enum TableShape {
  ROUND
  SQUARE
  RECT
}

// Shown as "Section" in the UI.
model Area {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  tables    Table[]
  closures  AreaClosure[]
}

// A section closed for a whole restaurant-local day (D-033). Its tables can't be booked that day.
model AreaClosure {
  id          String   @id @default(cuid())
  areaId      String
  area        Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  reason      String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([areaId, date])
  @@index([date])
}

model Table {
  id         String     @id @default(cuid())
  label      String     @unique
  areaId     String
  area       Area       @relation(fields: [areaId], references: [id])
  minSeats   Int        @default(1)
  maxSeats   Int
  combinable Boolean    @default(false)
  active     Boolean    @default(true)
  // Floor plan position on the reference canvas (wiki/modules/floor-plan.md)
  posX       Int        @default(0)
  posY       Int        @default(0)
  shape      TableShape @default(SQUARE)
  rotation   Int        @default(0)
  bookings   BookingTable[]
}

// Booking start window per weekday, in minutes after midnight (restaurant time).
model OpeningHours {
  dayOfWeek      Int     @id // 0 = Sunday … 6 = Saturday
  firstBookingAt Int     @default(360) // 06:00
  lastBookingAt  Int     @default(1200) // 20:00
}

// Single row (id = 1).
model BookingSettings {
  id                  Int @id @default(1)
  slotMinutes         Int @default(15)
  diningMinutes       Int @default(90)
  reservedSoonMinutes Int @default(30)
  lateGraceMinutes    Int @default(15)
}

// Bookings: wiki/modules/booking.md

enum BookingStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  PHONE
  WHATSAPP
  WALK_IN
  OTHER
}

model Booking {
  id           String         @id @default(cuid())
  guestName    String
  guestPhone   String?
  partySize    Int
  startAt      DateTime       @db.Timestamptz(3)
  endAt        DateTime       @db.Timestamptz(3)
  status       BookingStatus  @default(BOOKED)
  source       BookingSource  @default(PHONE)
  notes        String?
  seatedAt     DateTime?      @db.Timestamptz(3)
  completedAt  DateTime?      @db.Timestamptz(3)
  cancelledAt  DateTime?      @db.Timestamptz(3)
  cancelReason String?
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tables       BookingTable[]

  @@index([startAt])
}

// Large groups can sit at several combinable tables.
model BookingTable {
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table   @relation(fields: [tableId], references: [id])

  @@id([bookingId, tableId])
  @@index([tableId])
}
